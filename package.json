{
    "name": "uniwind-monorepo",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "build": "turbo build",
        "check:typescript": "turbo check:typescript",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "check:format": "dprint check",
        "precommit": "turbo precommit",
        "test": "turbo test",
        "format": "dprint fmt",
        "circular:check": "turbo circular:check",
        "postinstall": "git update-index --assume-unchanged packages/uniwind/uniwind.css"
    },
    "workspaces": {
        "packages": [
            "packages/*",
            "apps/*",
            "apps/module-federation/*"
        ],
        "catalog": {
            "typescript": "6.0.3",
            "@types/bun": "1.4.4",
            "@types/react": "19.3.0",
            "@types/react-dom": "19.3.0",
            "@expo/metro-runtime": "58.0.15",
            "@module-federation/metro": "2.9.0",
            "@module-federation/runtime": "2.9.0",
            "react": "19.3.0",
            "react-dom": "19.3.0",
            "expo": "58.0.19",
            "metro": "0.87.1",
            "react-native": "0.88.0",
            "react-native-web": "0.21.4",
            "tailwindcss": "4.3.3",
            "vite": "8.1.6"
        }
    },
    "devDependencies": {
        "typescript": "catalog:",
        "dprint": "0.64.3",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2005",
        "husky": "9.1.7",
        "turbo": "2.11.10"
    },
    "packageManager": "bun@1.4.4",
    "trustedDependencies": [
        "@tailwindcss/oxide"
    ],
    "patchedDependencies": {
        "@module-federation/metro@2.9.0": "patches/@module-federation%2Fmetro@2.9.0.patch"
    }
}
