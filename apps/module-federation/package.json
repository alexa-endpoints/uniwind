{
    "name": "uniwind-module-federation-example",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "ios": "bun ./start.mjs ios",
        "stop": "bun ./stop.mjs",
        "test:host-startup": "bun run --cwd ../../packages/uniwind build && playwright test --config ./playwright.config.ts ./tests/host-startup.test.ts",
        "test:remote-startup": "bun run --cwd ../../packages/uniwind build && playwright test --config ./playwright.remote.config.ts ./tests/remote-startup.test.ts",
        "test:loader": "node --test ./expo-federation-async-require.test.mjs",
        "verify:web": "node ./verify-web.mjs",
        "web": "bun ./start.mjs web"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "lightningcss": "1.30.1",
        "playwright": "1.63.0"
    }
}
